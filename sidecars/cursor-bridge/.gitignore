# Build output. This sidecar must never share a target directory with the
# Tauri app in src-tauri/ (see src-tauri/.cargo/config.toml, target-dir F:/target).
/target/
# Anchored: only the build output directory at the bridge root. An unanchored
# `bin/` would also match `server/src/bin/`, which holds the binary entry point
# source file.
/bin/
*.log

# Local runtime state written by the bridge when it is started by hand.
/sidecar-runtime/
